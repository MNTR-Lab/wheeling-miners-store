#!/usr/bin/env python3
"""Update five legacy tests for signed, store-bound Shopify paid webhooks.
No production changes. Run from repository root. Idempotent.
"""
from pathlib import Path

root = Path.cwd()
files = [
 'tests/seat-multi-paid-webhook-v123.test.mjs',
 'tests/seat-paid-webhook-integration-v118.test.mjs',
 'tests/seat-payment-integration-v95.test.mjs',
 'tests/seat-public-inventory.test.mjs',
 'tests/seat-worker-routing-v121.test.mjs',
]
for file in files:
 if not (root/file).is_file():
  raise SystemExit(f'Missing {file}. Run from the repository root.')

helper = root/'tests/helpers/verified-shopify-webhook-fixture.mjs'
helper.parent.mkdir(parents=True, exist_ok=True)
helper.write_text('''/** Test-only Shopify Admin verification mock. No external calls. */
import {handleShopifyPaidWebhook as productionHandler} from '../../src/seat-shopify-webhook.js';
export const SHOP='wheeling-miners-ticket-testing.myshopify.com';
export function testEnv(env){return {...env,WM_ENVIRONMENT:'TEST',SHOPIFY_STORE_DOMAIN:SHOP,SHOPIFY_CLIENT_ID:'fixture-client',SHOPIFY_CLIENT_SECRET:'fixture-secret',SEAT_TEST_AUTO_PAID_ENABLED:'true'};}
export function signedShopifyRequest(request){const headers=new Headers(request.headers);headers.set('x-shopify-shop-domain',SHOP);return new Request(request,{headers});}
export async function handleShopifyPaidWebhook(request,env,opts={}){
 const body=await request.clone().json();
 const id=String(body.id??123);
 const fetchImpl=async url=>{
  if(url.endsWith('/admin/oauth/access_token'))return Response.json({access_token:'fixture-access-token',scope:'read_orders'});
  if(url.includes('/transactions.json'))return Response.json({transactions:[{kind:'sale',status:'success',processed_at:'2026-10-25T12:00:00Z'}]});
  if(url.includes('/orders/'))return Response.json({order:{id:Number(id),financial_status:'paid'}});
  throw Error('UNEXPECTED_SHOPIFY_TEST_REQUEST');
 };
 return productionHandler(signedShopifyRequest(request),testEnv(env),{...opts,fetchImpl});
}
''')

# Three webhook integration suites: route through the isolated test-only adapter.
for name in files[:3]:
 p=root/name
 s=p.read_text()
 old="import {handleShopifyPaidWebhook} from '../src/seat-shopify-webhook.js';"
 new="import {handleShopifyPaidWebhook} from './helpers/verified-shopify-webhook-fixture.mjs';"
 if old not in s and new not in s: raise SystemExit(f'Unexpected webhook import in {name}')
 s=s.replace(old,new)
 p.write_text(s)

# Worker routing cannot inject a fetch mock, but its default-off tests need only
# a correctly authenticated TEST store to reach the intended inspection path.
p=root/files[4];s=p.read_text()
s=s.replace("'x-shopify-topic':'orders/paid'","'x-shopify-topic':'orders/paid','x-shopify-shop-domain':'wheeling-miners-ticket-testing.myshopify.com'")
s=s.replace("return {sql,env:{SHOPIFY_WEBHOOK_SECRET:secret,SEAT_DB:","return {sql,env:{WM_ENVIRONMENT:'TEST',SHOPIFY_STORE_DOMAIN:'wheeling-miners-ticket-testing.myshopify.com',SHOPIFY_WEBHOOK_SECRET:secret,SEAT_DB:")
p.write_text(s)

# Public inventory tests must supply the same approval/credential gate as checkout.
p=root/files[3];s=p.read_text()
needle="SEAT_CONTROLLED_CART_ENABLED:'true',SHOPIFY_STORE_DOMAIN:"
replacement="SEAT_CONTROLLED_CART_ENABLED:'true',SEAT_PAID_FULFILLMENT_ENABLED:'true',SEAT_PRODUCTION_PAID_COMMIT_APPROVED:'true',SHOPIFY_WEBHOOK_SECRET:'fixture-secret',SHOPIFY_CLIENT_ID:'fixture-id',SHOPIFY_CLIENT_SECRET:'fixture-client-secret',SHOPIFY_STOREFRONT_TOKEN:'fixture-storefront-token',SHOPIFY_STORE_DOMAIN:"
if needle not in s and replacement not in s:raise SystemExit('Unexpected public inventory fixture')
s=s.replace(needle,replacement)
p.write_text(s)
print('Updated five test files and created isolated Shopify verification fixture.')
print('Next: node --test tests/*.test.mjs')
